{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src", "prisma"],
  "exclude": [
    "src/**/*.test.ts",
    "src/scripts/**",
    "scripts/**",
    "src/canonical/**",
    "src/lib/azureFoundry.ts",
    "src/services/objective-export.service.ts"
  ]
}
