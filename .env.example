NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://user:password@localhost:5432/mylisa
SHADOW_DATABASE_URL=postgresql://user:password@localhost:5432/mylisa_shadow
JWT_SECRET=replace-with-a-long-random-secret
MYLISA_API_KEY=replace-with-a-long-random-api-key

AZURE_OPENAI_API_KEY=replace-me
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_VERSION=2025-01-01-preview
AZURE_OPENAI_CHAT_DEPLOYMENT=chat-deployment-name
AZURE_OPENAI_DEPLOYMENT=assessment-deployment-name

NDSCREEN_API_BASE_URL=http://127.0.0.1:4098
NDSCREEN_EXPORT_TOKEN=replace-me
NEWTONCENTRE_TIMETABLE_API_URL=http://172.17.0.4:4050/api/integrations/mylisa/timetable
NEWTONCENTRE_TIMETABLE_API_TOKEN=replace-with-newtoncentre-mylisa-integration-token
NEWTONCENTRE_COURSE_DATABASE_URL=postgresql://user:password@localhost:5432/newtoncentre
NEWTONCENTRE_TIMETABLE_DATABASE_URL=postgresql://user:password@localhost:5432/newtoncentre
GOOGLE_OIDC_CLIENT_IDS=google-web-client-id.apps.googleusercontent.com,google-ios-client-id.apps.googleusercontent.com,google-android-client-id.apps.googleusercontent.com

OAK_BASE_URL=https://open-api.thenational.academy/api/v0
OAK_RPH=950
OAK_TIMEOUT_MS=20000
OAK_ORGANISATION_SLUG=default
OAK_SUBJECTS=
OAK_SYNC_LOG_EVERY=25
OAK_SYNC_DEBUG=0
OAK_SYNC_DB_LOG=0
OAK_SYNC_DRY_RUN=0
OAK_SYNC_SKIP_TRANSCRIPT=0
OAK_SYNC_TRANSCRIPT_CHUNK_CHARS=1600
OAK_SYNC_TRANSCRIPT_MAX_CHUNKS=20

TAG_SCI_DRY_RUN=1
TAG_SCI_BATCH=100
TAG_SCI_MODEL=unknown
