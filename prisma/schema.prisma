// prisma/schema.prisma
// Production-safe schema
// Strand-safe, additive-first revision
//
// IMPORTANT:
// - Existing string strand fields are retained to avoid data loss.
// - New first-class CurriculumStrand model added.
// - New nullable strandId FKs added for safe backfill.
// - Attempt / AttemptItem get strand snapshots for history stability.
// - No destructive changes in this revision.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TaskType {
  CHAT
  CHECK_WORK
  MICRO_LESSON
  MINI_QUIZ
  PRACTICE_SET
  ASSESSMENT
}

enum CanonicalItemType {
  EQUATION
  MISSING_NUMBER
  COMPARISON
  ONE_MORE_ONE_LESS
  NUMBER_SEQUENCE
  NUMBER_LINE
  MEASUREMENT_COMPARE
  FRACTION_OF_QUANTITY
  TURN_DIRECTION
  TIME_MATCH
  DATE_SEQUENCE
  COIN_VALUE
  SHAPE_NAME
}

enum CanonicalOperator {
  ADD
  SUBTRACT
  MULTIPLY
  DIVIDE
  EQUALS
}

enum CanonicalItemStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum ScienceDomain {
  BIOLOGY
  CHEMISTRY
  PHYSICS
  GENERAL_SCIENCE
}

enum Role {
  STUDENT
  PARENT
  STAFF
  ADMIN
}

enum Subject {
  MATHS
  SCIENCE
  COMPUTING
  ENGLISH
}

enum KeyStage {
  KS1
  KS2
  KS3
  KS4
}

enum TutoringMode {
  AUTO
  GENTLE
  COACH
}

enum Verbosity {
  LOW
  MEDIUM
  HIGH
}

enum StepSize {
  SMALL
  NORMAL
}

enum AssessmentContext {
  HOMEWORK
  CLASSWORK
  REVISION
  ASSESSED
  UNKNOWN
}

enum AttemptStatus {
  STARTED
  SUBMITTED
  ABANDONED
}

enum HelpLevel {
  NONE
  HINT
  EXAMPLE
  MICRO_LESSON
}

enum UploadType {
  QUESTION
  STUDENT_WORK
  SUPPORTING_MATERIAL
}

enum StorageProvider {
  LOCAL
  S3
  AZURE_BLOB
}

enum ChunkType {
  OBJECTIVE
  EXPLANATION
  WORKED_EXAMPLE
  MISCONCEPTION
  PRACTICE
  COMMAND_WORDS
  GLOSSARY
}

enum DifficultyBand {
  EASY
  MEDIUM
  HARD
}

enum MasteryTrend {
  IMPROVING
  FLAT
  DECLINING
}

enum ConsentState {
  UNKNOWN
  GRANTED
  DENIED
}

enum IntegrationSource {
  NEWTONCENTRE
  NDSCREEN
}

enum VisibilityScope {
  ORG_ONLY
  COHORT
  STAFF_ONLY
  STUDENT_OWNED
}

enum RagLane {
  STRUCTURED_OBJECTIVE
  FREE_TEXT_LESSON
  HOMEWORK_HELP
}

enum EmbeddingStatus {
  PENDING
  READY
  FAILED
}

enum HomeworkLinkType {
  SAME_OBJECTIVE
  SAME_TOPIC
  PREREQ_GAP
  WORKED_EXAMPLE_MATCH
}

enum StudentVectorType {
  INTERESTS
  MISCONCEPTIONS
  STRENGTHS
}

model Organisation {
  id       String  @id @default(cuid())
  name     String
  slug     String  @unique
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                User[]
  students             Student[]
  curriculumSources    CurriculumSource[]
  curriculumStrands    CurriculumStrand[]
  ragTraces            RagTrace[]
  embeddings           Embedding[]
  curriculumObjectives CurriculumObjective[]
  contentChunks        ContentChunk[]
  uploads              Upload[]
  uploadChunks         UploadChunk[]
  homeworkLinks        HomeworkLink[]
  tutorThreads         TutorThread[]
  attempts             Attempt[]
  attemptItems         AttemptItem[]
  objectiveMasteries   ObjectiveMastery[]
  studentVectors       StudentVector[]
  wrapperVectors       WrapperVector[]
  coursePlans          CoursePlan[]
  coursePlanItems      CoursePlanItem[]
  lessonSessions       LessonSession[]
  lessonParticipants   LessonSessionParticipant[]
  lessonEvents         LessonSessionEvent[]
  auditEvents          AuditEvent[]
  canonicalQuestions   CanonicalQuestion[]

  @@index([isActive])
}

model User {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  email        String  @unique
  passwordHash String
  role         Role    @default(STUDENT)
  isActive     Boolean @default(true)

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  student           Student?
  sessions          Session[]
  ledLessonSessions LessonSession[] @relation("LessonSessionTutor")
  lessonEvents      LessonSessionEvent[]
  auditEvents       AuditEvent[]

  @@index([organisationId])
  @@index([role])
  @@index([isActive])
}

model Session {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model Student {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  firstName   String?
  lastName    String?
  dateOfBirth DateTime?
  age         Int
  schoolYear  Int?
  keyStage    KeyStage?
  subjects    Subject[]

  guardianEmail String?
  consentState  ConsentState @default(UNKNOWN)

  preferences StudentPreference?
  mastery     ObjectiveMastery[]
  attempts    Attempt[]
  uploads     Upload[]
  threads     TutorThread[]
  vectors            StudentVector[]
  wrapperVectors     WrapperVector[]
  integrationLinks   StudentIntegrationLink[]
  coursePlans        CoursePlan[]
  coursePlanItems    CoursePlanItem[]
  lessonParticipants LessonSessionParticipant[]
  lessonEvents       LessonSessionEvent[]

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  ragTraces RagTrace[]

  @@index([organisationId])
  @@index([keyStage])
  @@index([schoolYear])
}

model StudentIntegrationLink {
  id        String            @id @default(cuid())
  studentId String
  student   Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)

  source              IntegrationSource
  externalId          String
  externalType        String?
  parentEmail         String?
  ndscreenSessionId   String?
  assessmentSessionId String?
  syncedAt            DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([source, externalId])
  @@index([studentId])
  @@index([ndscreenSessionId])
}

model StudentPreference {
  id        String  @id @default(cuid())
  studentId String  @unique
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  tutoringMode TutoringMode @default(AUTO)
  verbosity    Verbosity    @default(LOW)
  stepSize     StepSize     @default(SMALL)

  lowStimulus      Boolean @default(true)
  avoidMetaphors   Boolean @default(false)
  useBullets       Boolean @default(true)
  moreExamples     Boolean @default(true)
  frequentCheckIns Boolean @default(true)

  readingLevel      Int?
  attentionSpanMins Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CurriculumSource {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  name        String
  slug        String
  description String?
  license     String
  attribution String?
  url         String?

  visibility VisibilityScope @default(ORG_ONLY)
  isActive   Boolean         @default(true)

  strands    CurriculumStrand[]
  objectives CurriculumObjective[]
  chunks     ContentChunk[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organisationId, slug])
  @@index([organisationId])
  @@index([visibility])
  @@index([isActive])
}

model CurriculumStrand {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  sourceId String?
  source   CurriculumSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  subject   Subject
  keyStage  KeyStage
  yearGroup Int?

  name String
  slug String

  description String?
  isActive    Boolean @default(true)

  objectives    CurriculumObjective[]
  contentChunks ContentChunk[]
  attempts      Attempt[]
  attemptItems  AttemptItem[]

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  canonicalQuestions CanonicalQuestion[]

  @@unique([organisationId, subject, keyStage, yearGroup, slug])
  @@index([organisationId])
  @@index([sourceId])
  @@index([subject, keyStage, yearGroup])
  @@index([slug])
  @@index([isActive])
}

model CurriculumObjective {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  code String

  subject   Subject
  keyStage  KeyStage
  yearGroup Int?

  // Existing field retained for safe compatibility
  strand String

  // New first-class strand link
  strandId  String?
  strandRef CurriculumStrand? @relation(fields: [strandId], references: [id], onDelete: SetNull)

  title     String
  statement String
  statutory Boolean @default(true)

  keywords String[]

  sourceId String
  source   CurriculumSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  visibility VisibilityScope @default(ORG_ONLY)
  isActive   Boolean         @default(true)

  chunks        ContentChunk[]
  mastery       ObjectiveMastery[]
  attemptItems  AttemptItem[]
  homeworkLinks HomeworkLink[]
  attempts      Attempt[]

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  canonicalQuestions CanonicalQuestion[]
  wrapperVectors     WrapperVector[]
  coursePlanItems    CoursePlanItem[]
  lessonSessions     LessonSession[]

  @@unique([organisationId, code])
  @@index([organisationId])
  @@index([subject, keyStage])
  @@index([keyStage, yearGroup])
  @@index([strand])
  @@index([strandId])
  @@index([visibility])
  @@index([sourceId])
  @@index([isActive])
}

model ContentChunk {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  sourceId String
  source   CurriculumSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  objectiveId String?
  objective   CurriculumObjective? @relation(fields: [objectiveId], references: [id], onDelete: SetNull)

  subject   Subject
  keyStage  KeyStage
  yearGroup Int?

  // Existing field retained
  strand String?

  // New first-class strand link
  strandId  String?
  strandRef CurriculumStrand? @relation(fields: [strandId], references: [id], onDelete: SetNull)

  type       ChunkType
  difficulty DifficultyBand @default(MEDIUM)

  content    String
  tokenCount Int?

  contentSha256 String   @unique
  citations     String[]
  tags          String[]

  visibility VisibilityScope @default(ORG_ONLY)
  isActive   Boolean         @default(true)

  scienceDomain           ScienceDomain?
  scienceDomainConfidence Float?
  scienceDomainModel      String?
  scienceDomainTaggedAt   DateTime?

  embeddingId String?
  embedding   Embedding? @relation(fields: [embeddingId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  homeworkLinks HomeworkLink[]

  @@index([organisationId])
  @@index([sourceId])
  @@index([objectiveId])
  @@index([subject, keyStage, yearGroup])
  @@index([strand])
  @@index([strandId])
  @@index([type])
  @@index([difficulty])
  @@index([visibility])
  @@index([isActive])
  @@index([scienceDomain])
  @@index([scienceDomainConfidence])
  @@index([embeddingId])
}

model CommandWord {
  id         String   @id @default(cuid())
  subject    Subject
  word       String
  definition String
  scaffolds  String[]
  examples   String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([subject, word])
  @@index([word])
}

model Embedding {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  model  String
  dims   Int
  status EmbeddingStatus @default(PENDING)
  error  String?

  inputSha256 String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contentChunks  ContentChunk[]
  uploadChunks   UploadChunk[]
  studentVectors StudentVector[]

  @@index([organisationId])
  @@index([status])
  @@index([model])
  @@index([dims])
}

model Upload {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  type         UploadType
  originalName String
  mimeType     String
  sizeBytes    BigInt

  storage        StorageProvider @default(LOCAL)
  storageKey     String
  checksumSha256 String?

  extractedText String?
  ocrConfidence Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attemptId String?
  attempt   Attempt? @relation(fields: [attemptId], references: [id], onDelete: SetNull)

  threadId String?
  thread   TutorThread? @relation(fields: [threadId], references: [id], onDelete: SetNull)

  chunks UploadChunk[]
  links  HomeworkLink[]

  @@index([organisationId])
  @@index([studentId])
  @@index([attemptId])
  @@index([threadId])
  @@index([type])
  @@index([createdAt])
}

model UploadChunk {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  uploadId String
  upload   Upload @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  chunkIndex Int
  content    String
  tokenCount Int?

  pageNumber Int?
  locator    Json?

  contentSha256 String

  embeddingId String?
  embedding   Embedding? @relation(fields: [embeddingId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([uploadId, chunkIndex])
  @@index([organisationId])
  @@index([uploadId])
  @@index([embeddingId])
}

model HomeworkLink {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  uploadId String
  upload   Upload @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  objectiveId String?
  objective   CurriculumObjective? @relation(fields: [objectiveId], references: [id], onDelete: SetNull)

  contentChunkId String?
  contentChunk   ContentChunk? @relation(fields: [contentChunkId], references: [id], onDelete: SetNull)

  linkType HomeworkLinkType
  score    Float

  createdAt DateTime @default(now())

  @@index([organisationId])
  @@index([uploadId])
  @@index([objectiveId])
  @@index([contentChunkId])
  @@index([linkType])
}

model TutorThread {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  subject           Subject
  taskType          TaskType          @default(CHAT)
  assessmentContext AssessmentContext @default(UNKNOWN)

  state Json?

  messages  TutorMessage[]
  uploads   Upload[]
  attempts  Attempt[]
  ragTraces RagTrace[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organisationId])
  @@index([studentId])
  @@index([subject])
  @@index([taskType])
}

model TutorMessage {
  id       String      @id @default(cuid())
  threadId String
  thread   TutorThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  role    String
  content String
  meta    Json?

  createdAt DateTime @default(now())

  @@index([threadId, createdAt])
}

model Attempt {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  subject           Subject
  taskType          TaskType
  assessmentContext AssessmentContext @default(UNKNOWN)

  primaryObjectiveId String?
  primaryObjective   CurriculumObjective? @relation(fields: [primaryObjectiveId], references: [id], onDelete: SetNull)

  threadId String?
  thread   TutorThread? @relation(fields: [threadId], references: [id], onDelete: SetNull)

  // New strand tracking for historical stability
  strandId    String?
  strandRef   CurriculumStrand? @relation(fields: [strandId], references: [id], onDelete: SetNull)
  strandLabel String?

  status AttemptStatus @default(STARTED)

  score         Float?
  helpUsed      HelpLevel @default(NONE)
  timeOnTaskSec Int?

  frustration String?
  notes       Json?

  items   AttemptItem[]
  uploads Upload[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  submittedAt DateTime?

  @@index([organisationId])
  @@index([studentId, createdAt])
  @@index([subject])
  @@index([taskType])
  @@index([primaryObjectiveId])
  @@index([threadId])
  @@index([strandId])
  @@index([status])
}

model AttemptItem {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  attemptId String
  attempt   Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  objectiveId String?
  objective   CurriculumObjective? @relation(fields: [objectiveId], references: [id], onDelete: SetNull)

  // Strand snapshot for historical stability
  strandId    String?
  strandRef   CurriculumStrand? @relation(fields: [strandId], references: [id], onDelete: SetNull)
  strandLabel String?

  // Canonical question linkage + immutable maths snapshot
  canonicalQuestionId String?
  canonicalQuestion   CanonicalQuestion? @relation(fields: [canonicalQuestionId], references: [id], onDelete: SetNull)

  canonicalEquation String?
  canonicalOperator CanonicalOperator?
  lhsA              Int?
  lhsB              Int?
  rhs               Int?

  prompt     String
  type       String
  difficulty DifficultyBand @default(MEDIUM)

  response  String?
  isCorrect Boolean?
  score     Float?

  errorTags          String[]
  misconceptionCodes String[]

  createdAt DateTime @default(now())

  @@index([organisationId])
  @@index([attemptId])
  @@index([objectiveId])
  @@index([strandId])
  @@index([canonicalQuestionId])
}

model ObjectiveMastery {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  objectiveId String
  objective   CurriculumObjective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)

  masteryScore    Float        @default(0.5)
  confidenceScore Float        @default(0.5)
  stabilityScore  Float        @default(0.5)
  trend           MasteryTrend @default(FLAT)

  commonErrorTags String[]
  lastSeenAt      DateTime?
  attemptsCount   Int       @default(0)
  correctCount    Int       @default(0)

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([studentId, objectiveId])
  @@index([organisationId])
  @@index([studentId])
  @@index([objectiveId])
  @@index([masteryScore])
}

model StudentVector {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  type StudentVectorType

  embeddingId String
  embedding   Embedding @relation(fields: [embeddingId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([studentId, type])
  @@index([organisationId])
  @@index([studentId])
  @@index([type])
}

model WrapperVector {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  objectiveId String?
  objective   CurriculumObjective? @relation(fields: [objectiveId], references: [id], onDelete: SetNull)

  title   String
  content String
  scope   String   @default("GENERAL")
  source  String   @default("MANUAL")

  strand    String?
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organisationId])
  @@index([studentId])
  @@index([objectiveId])
  @@index([scope])
  @@index([strand])
  @@index([isActive])
}


model CoursePlan {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  subject Subject @default(MATHS)
  title   String
  status  String  @default("DRAFT")

  assessmentSessionId String?
  ndscreenSessionId   String?
  sourceSummary       Json?

  items CoursePlanItem[]
  lessonSessions LessonSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organisationId])
  @@index([studentId])
  @@index([subject])
  @@index([status])
  @@index([assessmentSessionId])
}

model CoursePlanItem {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  coursePlanId String
  coursePlan   CoursePlan @relation(fields: [coursePlanId], references: [id], onDelete: Cascade)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  objectiveId String
  objective   CurriculumObjective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)

  sequence       Int
  strand         String
  yearGroup      Int?
  priorityWeight Float @default(1)
  reason         String
  status         String @default("PLANNED")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([coursePlanId, sequence])
  @@index([organisationId])
  @@index([studentId])
  @@index([objectiveId])
  @@index([strand])
  @@index([status])
}

model LessonSession {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  tutorUserId String
  tutorUser   User @relation("LessonSessionTutor", fields: [tutorUserId], references: [id], onDelete: Cascade)

  coursePlanId String?
  coursePlan   CoursePlan? @relation(fields: [coursePlanId], references: [id], onDelete: SetNull)

  objectiveId String
  objective   CurriculumObjective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)

  title           String
  status          String @default("DRAFT")
  currentBlockKey String?
  blockStartedAt  DateTime?
  startedAt       DateTime?
  endedAt         DateTime?

  flowJson Json
  tutorRuntimeJson Json?

  participants LessonSessionParticipant[]
  events       LessonSessionEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organisationId])
  @@index([tutorUserId])
  @@index([coursePlanId])
  @@index([objectiveId])
  @@index([status])
  @@index([currentBlockKey])
}

model LessonSessionParticipant {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  lessonSessionId String
  lessonSession   LessonSession @relation(fields: [lessonSessionId], references: [id], onDelete: Cascade)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  status             String @default("INVITED")
  currentBlockKey    String?
  currentQuestionId  String?
  questionsAnswered  Int @default(0)
  questionsCorrect   Int @default(0)
  lastActiveAt       DateTime?

  runtimeJson Json
  progressJson Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([lessonSessionId, studentId])
  @@index([organisationId])
  @@index([lessonSessionId])
  @@index([studentId])
  @@index([status])
  @@index([currentBlockKey])
}

model LessonSessionEvent {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  lessonSessionId String
  lessonSession   LessonSession @relation(fields: [lessonSessionId], references: [id], onDelete: Cascade)

  studentId String?
  student   Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)

  userId String?
  user   User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  type     String
  blockKey String?
  payload  Json?

  createdAt DateTime @default(now())

  @@index([organisationId])
  @@index([lessonSessionId, createdAt])
  @@index([studentId, createdAt])
  @@index([userId, createdAt])
  @@index([type])
}

model RagTrace {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  studentId String?
  student   Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)

  threadId String?
  thread   TutorThread? @relation(fields: [threadId], references: [id], onDelete: SetNull)

  lane RagLane

  queryTextHash String
  filters       Json?
  retrieved     Json?

  promptHash String?
  outputHash String?
  modelUsed  String?

  createdAt DateTime @default(now())

  @@index([organisationId, createdAt])
  @@index([studentId, createdAt])
  @@index([threadId, createdAt])
  @@index([lane])
}

model GeneratedLessonContent {
  id             String @id @default(cuid())
  organisationId String
  studentId      String?
  objectiveId    String?

  cacheKey String @unique
  blockKey String
  source   String
  status   String @default("APPROVED")

  contentJson   Json
  guardrailJson Json
  promptMeta    Json?

  modelUsed String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organisationId])
  @@index([studentId])
  @@index([objectiveId])
  @@index([blockKey])
  @@index([source])
  @@index([status])
  @@index([createdAt])
}

model AuditEvent {
  id             String        @id @default(cuid())
  organisationId String?
  organisation   Organisation? @relation(fields: [organisationId], references: [id], onDelete: SetNull)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  action     String
  entityType String?
  entityId   String?
  ip         String?
  userAgent  String?
  meta       Json?

  createdAt DateTime @default(now())

  @@index([organisationId, createdAt])
  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([entityType, entityId])
}

model CanonicalQuestion {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  objectiveId String
  objective   CurriculumObjective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)

  strandId    String?
  strandRef   CurriculumStrand? @relation(fields: [strandId], references: [id], onDelete: SetNull)
  strandLabel String?

  itemType CanonicalItemType  @default(EQUATION)
  operator CanonicalOperator?

  lhsA Int?
  lhsB Int?
  rhs  Int?

  equation    String?
  promptText  String
  answerText  String
  contentJson Json?

  sequence   Int
  difficulty DifficultyBand @default(EASY)

  isGenerated      Boolean @default(true)
  generatorVersion String?
  generatorMeta    Json?

  status CanonicalItemStatus @default(ACTIVE)

  contentSha256 String @unique

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  attemptItems AttemptItem[]

  @@unique([objectiveId, sequence])
  @@index([organisationId])
  @@index([objectiveId])
  @@index([strandId])
  @@index([itemType])
  @@index([status])
}
